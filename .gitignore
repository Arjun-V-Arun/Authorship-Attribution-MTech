# Python virtual environment
envAA/
venv/
.venv/

# Large experiment outputs (checkpoints regularly exceed GitHub's 100MB/file limit)
# regenerate locally with src/train_finetune.py and src/run_experiments.py
runs/
logs/

# Full, unfiltered Sayahna library crawl cache (superset of the curated
# sayahna-fiction/ and sayahna-essays/ corpora actually used for experiments).
